{
  "entities": {
    "VaccineSyncItem": {
      "title": "VaccineSyncItem",
      "description": "Vaccine stock record synced to Firestore with canonical syncKey and server timestamp",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Sync-safe vaccine numeric ID matching document ID" },
        "name": { "type": "string", "description": "Vaccine name" },
        "category": { "type": "string", "description": "Category e.g. Routine Pediatric" },
        "code": { "type": "string", "description": "Short vaccine code" },
        "syncKey": { "type": "string", "description": "Canonical normalized key (code/name) for cross-device deduplication" },
        "currentStock": { "type": "number", "description": "Remaining stock doses/vials" },
        "purchasePrice": { "type": "number", "description": "Purchase cost per dose/vial" },
        "sellingPrice": { "type": "number", "description": "Selling/admin price per dose" },
        "minStockAlert": { "type": "number", "description": "Low-stock alert threshold" },
        "storageTemp": { "type": "string", "description": "Cold-chain storage temperature" },
        "unit": { "type": "string", "description": "Unit label e.g. doses or vials" },
        "notes": { "type": "string", "description": "Additional notes" },
        "lastModifiedMillis": { "type": "number", "description": "Client wall-clock edit timestamp" },
        "deviceId": { "type": "string", "description": "Originating device identifier" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Authoritative Firestore server timestamp" }
      },
      "required": ["id", "name", "currentStock"]
    },
    "VendorSyncItem": {
      "title": "VendorSyncItem",
      "description": "Vendor or supplier record synced to Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Sync-safe vendor numeric ID" },
        "name": { "type": "string", "description": "Vendor company name" },
        "contactPerson": { "type": "string", "description": "Contact person name" },
        "phone": { "type": "string", "description": "Phone number" },
        "email": { "type": "string", "description": "Email address" },
        "address": { "type": "string", "description": "Vendor address" },
        "notes": { "type": "string", "description": "Vendor notes" },
        "createdAt": { "type": "number", "description": "Creation epoch millis" },
        "lastModifiedMillis": { "type": "number", "description": "Client wall-clock edit timestamp" },
        "deviceId": { "type": "string", "description": "Originating device identifier" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Authoritative Firestore server timestamp" }
      },
      "required": ["id", "name"]
    },
    "TransactionSyncItem": {
      "title": "TransactionSyncItem",
      "description": "Purchase, sale, or stock adjustment transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Sync-safe transaction ID" },
        "vaccineId": { "type": "number", "description": "Referenced vaccine ID" },
        "vaccineName": { "type": "string", "description": "Snapshot of vaccine name" },
        "type": { "type": "string", "description": "PURCHASE, SALE, ADJUSTMENT_ADD, or ADJUSTMENT_REDUCE" },
        "vendorId": { "type": "number", "description": "Optional vendor ID" },
        "vendorName": { "type": "string", "description": "Optional vendor name" },
        "quantity": { "type": "number", "description": "Quantity doses or vials" },
        "unitPrice": { "type": "number", "description": "Price per unit" },
        "costPricePerUnit": { "type": "number", "description": "Cost price per unit" },
        "totalAmount": { "type": "number", "description": "Total amount" },
        "profit": { "type": "number", "description": "Computed profit" },
        "batchNumber": { "type": "string", "description": "Batch number" },
        "expiryDate": { "type": "string", "description": "Expiry date" },
        "referenceOrCustomer": { "type": "string", "description": "Invoice number or patient name" },
        "timestamp": { "type": "number", "description": "Epoch timestamp of transaction" },
        "notes": { "type": "string", "description": "Notes" },
        "lastModifiedMillis": { "type": "number", "description": "Client wall-clock edit timestamp" },
        "deviceId": { "type": "string", "description": "Originating device identifier" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Authoritative Firestore server timestamp" }
      },
      "required": ["id", "vaccineId", "type", "quantity", "totalAmount"]
    },
    "PatientSyncItem": {
      "title": "PatientSyncItem",
      "description": "Registered patient with immunization details and reminders",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Sync-safe patient ID" },
        "patientName": { "type": "string", "description": "Child or patient full name" },
        "dobOrAge": { "type": "string", "description": "Age or date of birth" },
        "gender": { "type": "string", "description": "Gender" },
        "parentName": { "type": "string", "description": "Father or Mother name" },
        "mobileNumber": { "type": "string", "description": "Parent mobile number" },
        "vaccineGivenToday": { "type": "string", "description": "Vaccine administered today" },
        "vaccineGivenBatch": { "type": "string", "description": "Vaccine batch number" },
        "vaccineGivenDose": { "type": "string", "description": "Dose sequence e.g. Dose 1" },
        "dateGivenMillis": { "type": "number", "description": "Epoch timestamp of visit" },
        "nextPlannedVaccine": { "type": "string", "description": "Next scheduled vaccine" },
        "nextDueDate": { "type": "string", "description": "Next due date" },
        "nextDueDateMillis": { "type": "number", "description": "Next due date epoch millis" },
        "reminderStatus": { "type": "string", "description": "PENDING or SENT" },
        "lastReminderMillis": { "type": "number", "description": "Timestamp when reminder was sent" },
        "notes": { "type": "string", "description": "Doctor remarks" },
        "previousVaccinesHistory": { "type": "string", "description": "Previous immunization history" },
        "lastModifiedMillis": { "type": "number", "description": "Client wall-clock edit timestamp" },
        "deviceId": { "type": "string", "description": "Originating device identifier" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Authoritative Firestore server timestamp" }
      },
      "required": ["id", "patientName", "mobileNumber"]
    },
    "ClinicProfileSyncItem": {
      "title": "ClinicProfileSyncItem",
      "description": "Clinic branding, contact info, and app release config",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Profile ID usually 1" },
        "clinicName": { "type": "string", "description": "Clinic name" },
        "doctorName": { "type": "string", "description": "Doctor name" },
        "phone": { "type": "string", "description": "Clinic phone number" },
        "email": { "type": "string", "description": "Clinic email" },
        "address": { "type": "string", "description": "Full clinic address" },
        "registrationNumber": { "type": "string", "description": "Medical council registration number" },
        "logoType": { "type": "string", "description": "Preset icon identifier or custom" },
        "photoUri": { "type": "string", "description": "Custom photo URI string" },
        "themeColor": { "type": "string", "description": "Theme color key" },
        "billFooterNote": { "type": "string", "description": "Bill footer greeting" },
        "customWhatsappMessage": { "type": "string", "description": "WhatsApp reminder message template" },
        "lastModifiedMillis": { "type": "number", "description": "Client wall-clock edit timestamp" },
        "deviceId": { "type": "string", "description": "Originating device identifier" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Authoritative Firestore server timestamp" }
      },
      "required": ["clinicName", "doctorName", "phone"]
    }
  },
  "firestore": {
    "/users/{userId}/vaccines/{vaccineId}": {
      "schema": { "$ref": "#/entities/VaccineSyncItem" },
      "description": "User's synchronized vaccine inventory items"
    },
    "/users/{userId}/vendors/{vendorId}": {
      "schema": { "$ref": "#/entities/VendorSyncItem" },
      "description": "User's synchronized vendor directory"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/TransactionSyncItem" },
      "description": "User's synchronized purchase and sales transactions"
    },
    "/users/{userId}/patients/{patientId}": {
      "schema": { "$ref": "#/entities/PatientSyncItem" },
      "description": "User's synchronized patient registrations and reminders"
    },
    "/users/{userId}/clinicProfile/{docId}": {
      "schema": { "$ref": "#/entities/ClinicProfileSyncItem" },
      "description": "User's synchronized clinic profile and release config details"
    }
  }
}
